{
  "expo": {
    "name": "transient",
    "slug": "transient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/transient-icon.svg",
    "scheme": "transient",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/transient-icon.svg",
      "bundleIdentifier": "com.adamdotpy.transient"
    },
    "android": {
      "package": "com.adamdotpy.transient",
      "adaptiveIcon": {
        "backgroundColor": "#1A1A2E",
        "foregroundImage": "./assets/images/transient-icon.svg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "image": "./assets/images/transient-icon.svg",
          "imageWidth": 120
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Transient uses your location to show gigs near you."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b750cc2e-ec1f-417c-a903-c80c79141894"
      }
    },
    "owner": "transient"
  }
}
